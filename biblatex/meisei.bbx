\ProvidesFile{meisei.bbx}
[2024/12/10\space v0.1\space 明星大学経済学部 卒業論文用 書誌情報スタイル]

%%% 全角幅の単位 \zw がない環境への対策 %%%
% jpa.bbx はぶら下げインデントを \setlength{\bibhang}{2\zw} としている。
% \zw は LuaTeX-ja でしか定義されないため，jpa.bbx を読む間だけ
% pLaTeX/upLaTeX では zw 単位に，それ以外（LuaTeX-ja なしの LuaLaTeX，pdfLaTeX）では em に置き換える
\newif\ifbbx@meisei@nozw
\ifdefined\zw\else
  \bbx@meisei@nozwtrue
  \ifdefined\kanjiskip
    \def\zw{zw}%
  \else
    \def\zw{em}%
  \fi
\fi
% jpa.bbx の \DeclareUniquenameTemplate は現在の biblatex では無効な名前部分
% （giveni）を使っていてエラーになるため，読み込む間だけ無効にし，下で宣言し直す
\let\bbx@meisei@savedDUT\DeclareUniquenameTemplate
\renewcommand*{\DeclareUniquenameTemplate}[2][]{}
\RequireBibliographyStyle{jpa}
\let\DeclareUniquenameTemplate\bbx@meisei@savedDUT
\ifbbx@meisei@nozw
  \let\zw\undefined
\fi

%%%%%% jpa.bbx（2024年1月版）に対する変更 %%%%%%
% 以前は jpa.bbx を直接書き換えていたものを，ここで上書きする

%%% 著者名の区別：名のイニシャルではなく名全体で区別する %%%
\DeclareUniquenameTemplate{
  \namepart[use=true, base=true]{prefix}
  \namepart[base=true]{family}
  \namepart[base=true]{given}
  \namepart{suffix}
}

%%% 著者名の書式：外国語文献の名をイニシャルにせず全体を出力する %%%
\DeclareNameFormat{default}{%
  \ifthenelse{\boolean{japanese}}{%
    % 著者総数が\maxprtnamesより大きく，かつ著者の順番が\maxprtnamesと同じ場合
    \ifthenelse{\value{listcount}=\maxprtnames\AND\value{listcount}<\value{listtotal}}{%
      % 「...」で省略
      \space\ldots\space%
    }{%
      % 処理中の著者の順番が\maxprtnamesより大きく，総数未満である場合
      \ifthenelse{\value{listcount}>\maxprtnames\AND\value{listcount}<\value{listtotal}}{%
      }{%
        \ifthenelse{\value{listcount}=1}{}{%
          \ifthenelse{\value{listcount}<\maxprtnames}{%
            \printtext{・}%
          }{}%
        }%
        \namepartfamily%
        \space%
        \namepartgiven%
      }%
    }%
  }{%
    \ifthenelse{\value{listcount}=\maxprtnames\AND\value{listcount}<\value{listtotal}}{%
      \addcomma\space\ldots\space%
    }{%
      \ifthenelse{\value{listcount}>\maxprtnames\AND\value{listcount}<\value{listtotal}}{}{%
        \usebibmacro{name:family-given}%
        {\namepartfamily}%
        {\namepartgiven}%
        {\namepartprefix}%
        {\namepartsuffix}%
      }%
    }%
  }%
}
\DeclareNameFormat{given-family}{%
  \ifthenelse{\boolean{japanese}}{%
    \ifthenelse{\value{listcount}=\maxprtnames\AND\value{listcount}<\value{listtotal}}{%
      \space\ldots\space%
    }{%
      \ifthenelse{\value{listcount}>\maxprtnames\AND\value{listcount}<\value{listtotal}}{}{%
        \namepartfamily%
        \space%
        \namepartgiven%
        \ifthenelse{\value{listcount}=\value{listtotal}}{}{\printtext{・}}%
      }%
    }%
  }{%
    \ifthenelse{\value{listcount}=\maxprtnames\AND\value{listcount}<\value{listtotal}}{%
      \addcomma\space\ldots\space%
    }{%
      \ifthenelse{\value{listcount}>\maxprtnames\AND\value{listcount}<\value{listtotal}}{}{%
        \usebibmacro{name:given-family}%
        {\namepartfamily}%
        {\namepartgiven}%
        {\namepartprefix}%
        {\namepartsuffix}%
      }%
    }%
  }%
}

%%% 原著出版年の書式 %%%
\DeclareFieldFormat{origyear}{%
  \mkbibparens{#1}%
}

%%% 翻訳書（origauthor 使用の場合）%%%
% 日本語文献：原著出版年を origyear で出力し，origauthor がない場合も
% 著者名以下を出力する
\renewbibmacro*{translatedbook}{%
  \ifthenelse{\boolean{japanese}}{% 日本語文献
    \ifnameundef{origauthor}{}{%
      \renewcommand{\revsdnamepunct}{\addcomma\space}%
      \printnames[family-given]{origauthor}\setunit{\addperiod\addspace}%
      % \usebibmacro{date+extradate}\adddot\space%
      \printfield{origyear}\adddot\space % 原著出版年
      \printfield[emph]{origtitle}\setunit*{\adddot\space}%
      \printlist{origpublisher}\setunit*{\adddot\space}%
      \printtext{\\(}%
    }%
    \setboolean{japanese}{false}%
    \printnames{author}%
    \addspace\space\newunit%
    \renewcommand{\revsdnamepunct}{\space}%
    \setboolean{japanese}{true}%
    \usebibmacro{translator}%
    \ifnameundef{translatora}{}{\addspace\space}\usebibmacro{translatora}%
    \usebibmacro{date+extradate}\setunit*{\addperiod\addspace}%
    \printfield{title}%
    \iffieldundef{subtitle}{}{%
      \printfield{subtitle}%
    }%
    \setunit*{\addjspace}%
    \printlist{publisher}%
    \ifnameundef{origauthor}{}{\printtext{)}}%
  }{% 外国語文献
    % 原著者名
    \ifnameundef{author}{}{%
      \usebibmacro{author+year}\setunit{\addperiod\addspace}}%
    % 原編集者名
    \ifnameundef{editor}{}{%
      \usebibmacro{editor+year}\setunit{\addperiod\addspace}}%
    % 表題
    \printfield{title}%
    \iffieldundef{subtitle}{}{%
      \printfield{subtitle}%
    }%
    \addspace\bibopenparen%
    \iffieldundef{volume}{}{%
      \printtext{Vol.}\strfield{volume}%
      \addcomma\space}%
    \printnames[given-family]{translator}\addcomma\space%
    \usebibmacro{translatortype}%
    \bibcloseparen\adddot\space%
    \printlist{publisher}\adddot\space%
    \renewcommand*{\finentrypunct}{}%
    \printtext[parens]{Original work published \printorigdate}%
    %  \setunit{\printdelim{nameyeardelim}}
  }%
}

%%% 編集書の特定章 %%%
% 著者名の後に (編) を付けない。日本語文献は書籍情報の前に空白を入れる
\DeclareBibliographyDriver{inbook}{%
  \usebibmacro{begentry}%
  % 著者名，刊行年
  \printnames{author}%
  % \usebibmacro{ed-eds:author}%in
  \mkbibparens{\printdateextra}%
  \setunit{\addperiod\addspace}%
  % 特定章名
  \printfield{title}%
  \iffieldundef{subtitle}{}{%
    \printfield{subtitle}%
  }%
  \ifthenelse{\boolean{japanese}}{\addspace}{} % Inの代わりにスペース
  \usebibmacro{bookinfo}\setunit{\addspace}%
  \printtext[parens]{\iffieldundef{edition}{}{%
      \printfield{edition}\addcomma\space}%
    pp.\space\printfield{pages}}%
  \ifthenelse{\boolean{japanese}}{%
    \nopunct\setunit{\addjspace}%
    %    \renewcommand*{\finentrypunct}{}%
  }{\newunit}
  \printlist{publisher}%
  \usebibmacro{finentry}%
}

%%% カタカナ・半角アルファベット著者名 %%%
\ExplSyntaxOn
% 姓・名を連結し，biblatex の区切り命令と空白を除いた文字列を \l_tmpa_tl に格納
% （例：given = {リチャード\bibnamedelima B.} → リチャードB.）
\cs_new_protected:Npn \__meisei_name_string:
  {
    \tl_set:Ne \l_tmpa_tl
      { \exp_not:o \namepartfamily \exp_not:o \namepartgiven }
    \tl_remove_all:Nn \l_tmpa_tl { \bibnamedelima }
    \tl_remove_all:Nn \l_tmpa_tl { \bibnamedelimb }
    \tl_remove_all:Nn \l_tmpa_tl { \bibnamedelimc }
    \tl_remove_all:Nn \l_tmpa_tl { \bibnamedelimd }
    \tl_remove_all:Nn \l_tmpa_tl { \bibnamedelimi }
    \tl_set:Ne \l_tmpa_tl { \tl_to_str:V \l_tmpa_tl }
    \tl_remove_all:Nn \l_tmpa_tl { ~ }
  }
\prg_new_conditional:Npnn \meisei_name_katakana: { TF }
  {
    \__meisei_name_string:
    % 全角カタカナ・半角アルファベット・半角ピリオドのみからなり，
    % カタカナを1文字以上含む（例：フリーマン, リチャード B.）
    \regex_match:nVTF
      { \A [ァ-ヺー・A-Za-z.]* [ァ-ヺー] [ァ-ヺー・A-Za-z.]* \Z } \l_tmpa_tl
      { \prg_return_true: }
      { \prg_return_false: }
  }
\cs_new_eq:NN \meiseiNameKatakanaTF \meisei_name_katakana:TF
\DeclareNameFormat{meisei-author-scan}{%
  \meiseiNameKatakanaTF{\global\bbx@authorkatakanatrue}{}%
}
\prg_new_conditional:Npnn \meisei_name_special: { TF }
  {
    \__meisei_name_string:
    \regex_match:nVTF
      { \A [ァ-ヺー・A-Za-z.]* [ァ-ヺー] [ァ-ヺー・A-Za-z.]* \Z } \l_tmpa_tl
      { \prg_return_true: }
      {
        \regex_match:nVTF { \A [A-Za-z.]+ \Z } \l_tmpa_tl
          { \prg_return_true: }
          { \prg_return_false: }
      }
  }
\cs_new_eq:NN \meiseiNameSpecialTF \meisei_name_special:TF
% カタカナ名用：名の中の区切り（空白）を中黒に置き換えて出力
% （例：リチャード\bibnamedelima B. → リチャード・B.）
\tl_new:N \l__meisei_given_tl
\cs_new_protected:Npn \meiseiGivenNakaguro
  {
    \tl_set:No \l__meisei_given_tl { \namepartgiven }
    \tl_replace_all:Nnn \l__meisei_given_tl { \bibnamedelima } { ・ }
    \tl_replace_all:Nnn \l__meisei_given_tl { \bibnamedelimb } { ・ }
    \tl_replace_all:Nnn \l__meisei_given_tl { \bibnamedelimc } { ・ }
    \tl_replace_all:Nnn \l__meisei_given_tl { \bibnamedelimd } { ・ }
    \tl_replace_all:Nnn \l__meisei_given_tl { \bibnamedelimi } { ・ }
    % イニシャルのピリオドを外す（B. → B）
    \tl_remove_all:Nn \l__meisei_given_tl { . }
    \tl_use:N \l__meisei_given_tl
  }
\ExplSyntaxOff
\newif\ifbbx@authorkatakana
\DeclareNameFormat{meisei-author}{%
  \ifthenelse{\boolean{japanese}}{%
    \ifthenelse{\value{listcount}=\maxprtnames\AND\value{listcount}<\value{listtotal}}{%
      \space\ldots\space%
    }{%
      \ifthenelse{\value{listcount}>\maxprtnames\AND\value{listcount}<\value{listtotal}}{}{%
        \ifthenelse{\value{listcount}=1}{}{%
          \ifbbx@authorkatakana
            \printtext{、}%
          \else
            \meiseiNameSpecialTF
              {%
                \meiseiNameKatakanaTF
                  {\printtext{、}}%
                  {%
                    % 半角アルファベット名：「A, B and C」
                    \ifthenelse{\value{listcount}=\value{liststop}}%
                      {\addspace and\space}%
                      {\isdot\addcomma\space}% \isdot：「A.」の後のカンマが消えないように
                  }%
              }%
              {\printtext{・}}%
          \fi
        }%
        \meiseiNameSpecialTF
          {%
            \meiseiNameKatakanaTF
              {%
                % カタカナ名：「名・姓」の順
                \ifdefvoid{\namepartgiven}{}{\meiseiGivenNakaguro\printtext{・}}%
                \namepartfamily
              }{%
                % 半角アルファベット名：1番目は「姓, 名」，2番目以降は「名 姓」
                \ifnumgreater{\value{listcount}}{1}{%
                  \ifdefvoid{\namepartgiven}{}{\namepartgiven\space}%
                  \namepartfamily
                }{%
                  \namepartfamily
                  \ifdefvoid{\namepartgiven}{}{\addcomma\space\namepartgiven}%
                }%
              }%
          }{%
            \namepartfamily\space\namepartgiven
          }%
      }%
    }%
  }{%
    \ifthenelse{\value{listcount}=\maxprtnames\AND\value{listcount}<\value{listtotal}}{%
      \addcomma\space\ldots\space%
    }{%
      \ifthenelse{\value{listcount}>\maxprtnames\AND\value{listcount}<\value{listtotal}}{}{%
        \meiseiNameKatakanaTF
          {%
            % カタカナ名：「名・姓」の順
            \ifdefvoid{\namepartgiven}{}{\meiseiGivenNakaguro\printtext{・}}%
            \namepartfamily
          }{%
            % 1番目の著者は「姓, 名」，2番目以降は「名 姓」（カンマなし）
            \ifnumgreater{\value{listcount}}{1}{%
              \usebibmacro{name:given-family}%
                {\namepartfamily}%
                {\namepartgiven}%
                {\namepartprefix}%
                {\namepartsuffix}%
            }{%
              \usebibmacro{name:family-given}%
                {\namepartfamily}%
                {\namepartgiven}%
                {\namepartprefix}%
                {\namepartsuffix}%
            }%
          }%
      }%
    }%
  }%
}
\DeclareNameAlias{author}{meisei-author}
%%% 外国語文献の最後の著者の前の区切り：「&」の代わりに「and」 %%%
% 2名：「A and B」，3名以上：「A, B and C」
\DeclareDelimFormat[bib,biblist]{finalnamedelim}{%
  \ifthenelse{\boolean{japanese}}{・}{%
    \ifthenelse{\value{listcount}>\maxprtnames}{}{%
      \addspace and\space
    }%
  }%
}

%%% 翻訳者の役割表示（日本語では括弧を付けない） %%%
\renewbibmacro*{translatortype}{%
  \ifthenelse{\boolean{japanese}}{%
    \iffieldundef{translatortype}{\setunit{\addspace}\printtext{訳}}{\printfield{translatortype}}%
  }{%
    \iffieldundef{translatortype}{%
      \printfield{translatortype}\printtext{Trans.}%
    }{%
      \printfield{translatortype}%
    }%
  }%
}
\renewbibmacro*{translatoratype}{%
  \ifthenelse{\boolean{japanese}}{%
    \ifnameundef{translatora}{}{%
      \iffieldundef{translatoratype}{%
        \setunit{\addspace}\printtext{訳}%
      }{%
        \printfield{translatoratype}%
      }%
    }%
  }{%
    \iffieldundef{translatora}{}{%
      \iffieldundef{translatoratype}{%
        \printfield{translatoratype}\printtext{Trans.}%
      }{%
        \printfield{translatoratype}%
      }%
    }%
  }%
}

%%% boolean{japanese}を再定義 %%%
%%% language が japanese 以外に ja, jpn, Japanese でも反応するようにする %%%
\setboolean{japanese}{false}
\AtEveryBibitem{
  \clearfield{doi}%
  \iflistundef{language}{}{%
    \ifthenelse{%
      \equal{\thefirstlistitem{language}}{japanese}\OR
      \equal{\thefirstlistitem{language}}{Japanese}\OR
      \equal{\thefirstlistitem{language}}{ja}\OR
      \equal{\thefirstlistitem{language}}{jp}\OR
      \equal{\thefirstlistitem{language}}{jpn}\OR
      \equal{\thefirstlistitem{language}}{日本語}}{%
      \setboolean{japanese}{true}%
      % jpa.bbx では language = japanese のときのみ行われる区切りの設定
      \renewcommand*{\newunitpunct}{}%
      \renewcommand*{\finentrypunct}{}%
      \renewcommand*{\multinamedelim}{・}%
      \renewcommand*{\revsdnamepunct}{\addspace}%
    }{}%
  }%
}
\AtEveryBibitem{%
  \global\bbx@authorkatakanafalse
  \begingroup
    \printnames[meisei-author-scan]{author}%
  \endgroup
}

%%% 「著者 (出版年)」直後のピリオドを日本語文献のみ抑制 %%%
% 引数には外国語文献のときの区切り（jpa.bbx の元の記述）を渡す
% 日本語文献のときの区切りを変えたい場合は \addspace の部分を書き換える
\RequirePackage{xpatch}
\newrobustcmd*{\bbx@nameyearpunct}[1]{%
  \ifthenelse{\boolean{japanese}}{\addspace}{#1}%
}
% パッチ用ヘルパー：#1 = \xpatchbibdriver または \xpatchbibmacro，#2 = 名前，
% #3 = 年の直後までの記述，#4 = 元の区切り（\setunit 等を含む）
\newcommand*{\bbx@meisei@nypatch}[5]{%
  #1{#2}{#3#4{#5}}{#3#4{\bbx@nameyearpunct{#5}}}{}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `#2'}}%
}
% 雑誌論文・オンライン資料・学位論文・学会発表・新聞記事
\@for\bbx@tmp:=article,online,thesis,inproceedings,misc\do{%
  \expandafter\bbx@meisei@nypatch\expandafter\xpatchbibdriver\expandafter{\bbx@tmp}%
    {\usebibmacro{author+year}}{\setunit}{\addperiod\addspace}}
%%% 参考文献一覧の並べ替え：読み（yomi）を優先 %%%
% 漢字は文字コード順（部首順）に並ぶため，五十音順にしたい文献には読みを書く。
%   著者がいる場合：yomi = {やまだ たろう}
%   著者がない場合：yomi = {せいさくのかいせつ}（表題の読み）
% Zotero（Better BibTeX）では「その他（Extra）」欄に tex.yomi: やまだ たろう と書く。
% biblatex 標準の nyt から，著者等による並べ替えの先頭に yomi を加えたもの
\DeclareSortingTemplate{nyt}{
  \sort{
    \field{presort}
  }
  \sort[final]{
    \field{sortkey}
  }
  \sort{
    \field{yomi}
    \field{sortname}
    \field{author}
    \field{editor}
    \field{translator}
    \field{sorttitle}
    \field{title}
  }
  \sort{
    \field{sortyear}
    \field{year}
  }
  \sort{
    \field{sorttitle}
    \field{title}
  }
  \sort{
    \field{volume}
    \literal{0}
  }
}
%%% 出版年がなく閲覧日（urldate）しかない文献は，引用で年を出さない %%%
% （Smith (2026) → Smith，(Smith, 2026) → (Smith)）
% biblatex の既定から urldate と「n.d.」（\literal{nodate}）を除く
\DeclareLabeldate{%
  \field{date}
  \field{year}
  \field{eventdate}
  \field{origdate}
}

% オンライン資料（@online）は参考文献一覧に出版年「(年)」を出さない
% （著者名の後にすぐ表題を続ける。引用では従来どおり年を出す）
% 著者がない場合は区切りも置かない（置くと表題の後に余分な空白が出る）
\xpatchbibdriver{online}%
  {\usebibmacro{author+year}\setunit{\bbx@nameyearpunct{\addperiod\addspace}}}%
  {\ifnameundef{author}{}{\printnames{author}\setunit{\bbx@nameyearpunct{\addperiod\addspace}}}}{}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `online'}}
% 代わりに，発行者（organization）の後，URL の前に日付を出す
% 英語：March 4, 2021.／日本語：2021年3月4日（月・日がなければ省略，期間は「–」でつなぐ）
\newcommand*{\bbx@meisei@jadate}[1]{%
  \thefield{#1year}年%
  \iffieldundef{#1month}{}{\thefield{#1month}月%
    \iffieldundef{#1day}{}{\thefield{#1day}日}}}
\newbibmacro*{meisei:onlinedate}{%
  \iffieldundef{year}{}{%
    \ifthenelse{\boolean{japanese}}{%
      % jpa.bbx の online ドライバは発行者の後に全角幅の空白を置いているので，空白は足さない
      \printtext{%
        \begingroup
        \ifdefined\ltjsetparameter\ltjsetparameter{autoxspacing=false}\fi
        \bbx@meisei@jadate{}%
        \iffieldundef{endyear}{}{%
          \bibdaterangesep
          \iffieldequalstr{endyear}{}{}{\bbx@meisei@jadate{end}}}%
        \endgroup}%
    }{%
      \newunit
      \printtext{\mkdaterangelong{}}%
    }}}
\xpatchbibdriver{online}%
  {\newunit\iffieldundef{doi}}%
  {\usebibmacro{meisei:onlinedate}\newunit\iffieldundef{doi}}{}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `online' (date)}}
% 数巻にわたる書籍（編者・著者）
\bbx@meisei@nypatch\xpatchbibdriver{mvbook}%
  {\usebibmacro{editor+year}}{\setunit}{\addperiod\addspace}
\bbx@meisei@nypatch\xpatchbibdriver{mvbook}%
  {\usebibmacro{author+year}}{\setunit}{\addperiod\addspace}
% 編集書の特定章・数巻にわたる書籍の特定の1巻
\bbx@meisei@nypatch\xpatchbibdriver{inbook}%
  {\mkbibparens{\printdateextra}}{\setunit}{\addperiod\addspace}
\bbx@meisei@nypatch\xpatchbibdriver{incollection}%
  {\mkbibparens{\printdateextra}}{\setunit}{\addperiod\addspace}
% 年報・年鑑（\setunit を使わず直接ピリオドを出力している）
\xpatchbibdriver{report}%
  {\mkbibparens{\printdateextra}\adddot\addspace}%
  {\mkbibparens{\printdateextra}\bbx@nameyearpunct{\adddot\addspace}}{}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `report'}}
% 書籍（著者・編者）
\bbx@meisei@nypatch\xpatchbibmacro{book}%
  {\printtext[parens]{\printdateextra}}{\setunit}{\addperiod\addspace}
\bbx@meisei@nypatch\xpatchbibmacro{book}%
  {\printtext[parens]{\printdateextra}}{\setunit}{\adddot\space}

%%% 書籍の版数・訳者 %%%
\DeclareFieldFormat[book]{edition}{%
  \ifthenelse{\boolean{japanese}}{%
    \ifdefined\ltjsetparameter
      \begingroup\ltjsetparameter{autoxspacing=false}第#1版\endgroup
    \else
      第#1版%
    \fi
  }{%
    % 外国語：数字なら序数＋ed.（2 → 2nd ed.），
    % 「2nd」のような序数表記なら ed. を付ける，それ以外はそのまま
    \iffieldint{edition}{%
      \mkbibordedition{#1}\addnbspace ed.%
    }{%
      \bbx@meisei@ifordinal{#1}{#1\addnbspace ed.}{#1}%
    }%
  }%
}
\ExplSyntaxOn
\cs_new_protected:Npn \bbx@meisei@ifordinal #1
  {
    \regex_match:nnTF { \A \d+ (st|nd|rd|th) \Z } {#1}
  }
\ExplSyntaxOff
\newbibmacro*{edition+translator}{%
  \iffieldundef{edition}{}{\setunit{\addspace}\printfield{edition}}%
  \ifnameundef{translator}{}{\setunit{\addspace}\usebibmacro{translator}}%
  \ifnameundef{translatora}{}{\setunit{\addspace}\usebibmacro{translatora}}%
}
\xpatchbibmacro{translatedbook}
  {\usebibmacro{translator}\ifnameundef{translatora}{}{\addspace\space}\usebibmacro{translatora}\usebibmacro{date+extradate}}
  {\usebibmacro{date+extradate}}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `translatedbook translator order'}%
  }
\xpatchbibmacro{translatedbook}
  {\setunit*{\addjspace}\printlist{publisher}}
  {\usebibmacro{edition+translator}\setunit*{\addjspace}\printlist{publisher}}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `translatedbook edition and translator'}%
  }
\xpatchbibmacro{translatedbook:japanese}
  {\usebibmacro{translator}\ifnameundef{translatora}{}{\printnames{translatora}\usebibmacro{translatoratype}\addspace}\usebibmacro{date+extradate}}
  {\usebibmacro{date+extradate}}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `translatedbook:japanese translator order'}%
  }
\xpatchbibmacro{translatedbook:japanese}
  {\setunit*{\addjspace}\printlist{publisher}}
  {\usebibmacro{edition+translator}\setunit*{\addjspace}\printlist{publisher}}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `translatedbook:japanese edition and translator'}%
  }

% 編集書の特定章：著者名と出版年の間に空白を入れる（Brown, Alice (2015)）
\xpatchbibdriver{inbook}
  {\printnames{author}\mkbibparens{\printdateextra}}
  {\printnames{author}\ifnameundef{author}{}{\addspace}\mkbibparens{\printdateextra}}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `inbook author-year space'}%
  }
% 著者が編者の場合の (Ed.)/(Eds.)：jpa.bbx の外国語文献の分岐で
% \iffieldequalstr の偽の場合の引数が欠けていてエラーになるため定義し直す
% 日本語文献は括弧を付けず「鈴木 一郎 編」とする
\renewbibmacro*{ed-eds:author}{%
  \ifthenelse{\boolean{japanese}}{%
    \iffieldequalstr{authortype}{editor}{%
      \setunit{\addspace}\printtext{編}}{%
      \iffieldundef{authortype}{}{\setunit{\addspace}\printfield{authortype}}}%
  }{%
    \iffieldequalstr{authortype}{editor}{%
      \ifthenelse{\value{author}>1}{%
        \addspace\printtext[parens]{Eds.}%
      }{%
        \addspace\printtext[parens]{Ed.}%
      }%
    }{}%
  }%
}
% 編者・編者A の役割表示：日本語文献は括弧を付けず「中村 四郎 編」とする
\renewbibmacro*{ed-eds:editor}{%
  \ifthenelse{\boolean{japanese}}{%
    \setunit{\addspace}%
    \iffieldundef{editortype}{\printtext{編}}{%
      \iffieldequalstr{editortype}{editor}{\printtext{編}}{\printfield{editortype}}}%
  }{%
    \ifthenelse{\value{editor}>1}{%
      \addspace\printtext[parens]{Eds.}%
    }{%
      \addspace\printtext[parens]{Ed.}%
    }%
  }%
}
\renewbibmacro*{ed-eds:editora}{%
  \ifthenelse{\boolean{japanese}}{%
    \setunit{\addspace}%
    \iffieldundef{editoratype}{\printtext{編}}{%
      \iffieldequalstr{editoratype}{editor}{\printtext{編}}{\printfield{editoratype}}}%
  }{%
    \ifthenelse{\value{editora}>1}{%
      \addspace\printtext[parens]{Eds.}%
    }{%
      \addspace\printtext[parens]{Ed.}%
    }%
  }%
}
% 編集書の特定章（inbook）の書籍情報
% 外国語文献：「“章タイトル,” in 書籍タイトル, ed. 名 姓」（in Handbook of Labor Economics, ed. David Card）
% 日本語文献は jpa.bbx と同じ
\renewbibmacro{bookinfo}{%
  \ifthenelse{\boolean{japanese}}{%
    \ifnameundef{editor}{}{%
      \printnames{editor}\usebibmacro{ed-eds:editor}\setunit{\addspace}}%
    \printfield{booktitle}%
    \iffieldundef{booksubtitle}{}{\printfield{booksubtitle}}%
  }{%
    % 章タイトルの引用符内のカンマの後に続ける
    \setunit{\addspace}%
    \printtext{in}\setunit{\addspace}%
    \printfield{booktitle}%
    \iffieldundef{booksubtitle}{}{\printfield{booksubtitle}}%
    \ifnameundef{editor}{}{%
      \setunit{\addcomma\addspace}\printtext{ed.}\setunit{\addspace}%
      \printnames[given-family]{editor}}%
  }%
}
% 書籍（@book）で著者が編者（authortype = {editor}）の場合の役割表示
% （小林 六郎 編 (2012)／Gray, Eve (Ed.). (2012)）
% ※ xpatch の置換文字列内では % を使わないこと
\xpatchbibmacro{book}
  {\printnames{author}\space}
  {\printnames{author}\usebibmacro{ed-eds:author}\ifthenelse{\boolean{japanese}}{}{\iffieldequalstr{authortype}{editor}{\adddot}{}}\space}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `book author type'}%
  }
% 数巻にわたる書籍の特定の1巻：外国語文献で著者名の後にピリオドを入れない
% （Green, Bob (2016)）。日本語文献は空白を入れる（鈴木 一郎 編 (2019)）。編者の場合は APA に合わせて「(Ed.). (2016)」のまま
\xpatchbibdriver{incollection}
  {\usebibmacro{ed-eds:author}\ifthenelse{\boolean{japanese}}{}{\adddot\addspace}}
  {\usebibmacro{ed-eds:author}\ifthenelse{\boolean{japanese}}{\addspace}{\iffieldequalstr{authortype}{editor}{\adddot\addspace}{\addspace}}}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `incollection author-year punctuation'}%
  }
% 書籍の巻数（1冊）：外国語文献は立体で「Vol. 2」とする
%%% 日本語の巻数：数字なら「第n巻」，それ以外はそのまま %%%
\newcommand*{\bbx@meisei@javolume}{%
  \iffieldint{volume}{%
    \ifdefined\ltjsetparameter
      \begingroup\ltjsetparameter{autoxspacing=false}第\strfield{volume}巻\endgroup
    \else
      第\strfield{volume}巻%
    \fi
  }{\strfield{volume}}%
}
\renewbibmacro*{volume:book}{%
  \ifthenelse{\boolean{japanese}}{%
    \addspace\nopunct\bbx@meisei@javolume
  }{%
    \addspace\printtext{Vol.\addnbspace\strfield{volume}}%
  }%
}
% シリーズ編者：編者がいないときに「(, Series Ed.)」や「(編)」が出ないようにする
\renewbibmacro*{series-editor}{%
  \ifthenelse{\boolean{japanese}}{%
    \ifnameundef{editor}{\addjspace}{%
      \addjspace\printnames{editor}%
      \usebibmacro{ed-eds:editor}\addjspace%
    }%
  }{%
    \ifnameundef{editor}{}{%
      \addspace\bibopenparen\printnames[given-family]{editor}%
      \setunit{\addcomma\addspace}\printtext{Series}\addspace%
      \ifthenelse{\value{editor}>1}{\printtext{Eds.}}{\printtext{Ed.}}%
      \bibcloseparen%
      \setunit{\addcomma\addspace}%
    }%
  }%
}

% 書籍（@book）の巻数：jpa.bbx の book マクロは volume を出力しないので，
% 表題（副題）の直後に追加する（Single Book. Vol. 4. ／『書名』第2巻）
\newbibmacro*{meisei:bookvolume}{%
  \iffieldundef{volume}{}{%
    \ifthenelse{\boolean{japanese}}{%
      \setunit{\addspace}\printtext{\bbx@meisei@javolume}%
    }{%
      \setunit{\adddot\addspace}\printtext{Vol.\addnbspace\strfield{volume}}%
    }%
  }%
}
\xpatchbibmacro{book}
  {\iffieldundef{subtitle}{}{\printfield{subtitle}}}
  {\iffieldundef{subtitle}{}{\printfield{subtitle}}\usebibmacro{meisei:bookvolume}}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `book volume'}%
  }

% 翻訳書の著者名と出版年の間の二重スペース（\addspace\space）を1つにする
\xpatchbibmacro{translatedbook}
  {\printnames{author}\addspace\space\newunit}
  {\printnames{author}\setunit{\addspace}}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `translatedbook author spacing'}%
  }
\xpatchbibmacro{translatedbook:japanese}
  {\printnames{author}\addspace\space\newunit}
  {\printnames{author}\setunit{\addspace}}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `translatedbook:japanese author spacing'}%
  }

% 翻訳書の日本語訳部分
\bbx@meisei@nypatch\xpatchbibmacro{translatedbook}%
  {\usebibmacro{date+extradate}}{\setunit*}{\addperiod\addspace}
\bbx@meisei@nypatch\xpatchbibmacro{translatedbook:japanese}%
  {\usebibmacro{date+extradate}}{\setunit*}{\addperiod\addspace}
% シリーズ（日本語書籍）の著者・編者
\bbx@meisei@nypatch\xpatchbibmacro{bookseries:japanese}%
  {\printtext[parens]{\printdateextra}}{\setunit}{\adddot\addspace}
\bbx@meisei@nypatch\xpatchbibmacro{bookseries:japanese}%
  {\printtext[parens]{\printdateextra}}{\setunit}{\adddot\addspace}

%%% 文献末尾のピリオドを日本語文献のみ抑制 %%%
% 末尾の区切り（\finentrypunct）を言語で切り替える
\renewcommand*{\finentrypunct}{%
  \ifthenelse{\boolean{japanese}}{}{\addperiod}%
}
% ページ番号の直後に直接ピリオドを出力しているドライバ（article, misc）
\newrobustcmd*{\bbx@jaomit}[1]{%
  \ifthenelse{\boolean{japanese}}{}{#1}%
}
\@for\bbx@tmp:=article,misc\do{%
  \expandafter\xpatchbibdriver\expandafter{\bbx@tmp}%
    {\printfield{pages}\adddot}{\printfield{pages}\bbx@jaomit{\adddot}}{}{%
      \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `\bbx@tmp'}}}

%%% 書籍タイトル %%%
% 日本語のタイトルには二重鉤括弧、外国語のタイトルは強調
\DeclareFieldFormat[book,mvbook,online,thesis,inproceedings,incollection]{title}{%
  \ifthenelse{\boolean{japanese}}{%
    『#1%
    \iffieldundef{subtitle}{』}{}%
  }{\mkbibitalic{#1}}%
}
\DeclareFieldFormat[book,mvbook,online,thesis,inproceedings,incollection]{subtitle}{%
  \ifthenelse{\boolean{japanese}}{%
    ------#1------』\setunit{\addjspace}%
  }{%
    \mkbibitalic{\addcolon\addspace#1}%
  }%
}
% オンライン資料（online）の日本語の表題は『』ではなく「」で括る（外国語はイタリックのまま）
\DeclareFieldFormat[online]{title}{%
  \ifthenelse{\boolean{japanese}}{%
    「#1%
    \iffieldundef{subtitle}{」}{}%
  }{\mkbibitalic{#1}}%
}
\DeclareFieldFormat[online]{subtitle}{%
  \ifthenelse{\boolean{japanese}}{%
    ------#1------」\setunit{\addjspace}%
  }{%
    \mkbibitalic{\addcolon\addspace#1}%
  }%
}

%%% 論文タイトル %%%
% 外国語の論文・章タイトルは引用符で括り（副題も含める），カンマを引用符の
% 内側に置く（米国式：“Returns to Education: A Survey,” Journal of ...）。
% タイトルが「?」「!」で終わる場合はカンマを付けない（“Why?” Journal of ...）
\ExplSyntaxOn
\cs_new_protected:Npn \bbx@meisei@ifendsqe #1 #2 #3
  {
    \str_set:Ne \l_tmpa_str { \tl_to_str:n {#1} }
    \str_set:Ne \l_tmpb_str { \str_item:Nn \l_tmpa_str { -1 } }
    \bool_lazy_or:nnTF
      { \str_if_eq_p:Vn \l_tmpb_str { ? } }
      { \str_if_eq_p:Vn \l_tmpb_str { ! } }
      {#2} {#3}
  }
% 引用符内の区切り（通常はカンマ。報告書でタイトルの後に何も続かないときはピリオド）
\tl_new:N \bbx@meisei@titlepunct
\tl_set:Nn \bbx@meisei@titlepunct { , }
\AtEveryBibitem { \tl_set:Nn \bbx@meisei@titlepunct { , } }
\cs_new_protected:Npn \bbx@meisei@quotedtitle #1
  {
    \iffieldundef { subtitle }
      { \tl_set:Nn \l_tmpb_tl {#1} }
      { \tl_set:Ne \l_tmpb_tl { \exp_not:v { abx@field@subtitle } } }
    \exp_args:NV \bbx@meisei@ifendsqe \l_tmpb_tl
      { \tl_clear:N \l_tmpa_tl }
      { \tl_set:Nn \l_tmpa_tl { \bbx@meisei@titlepunct } }
    \mkbibquote
      {
        #1
        \iffieldundef { subtitle } { }
          { \addcolon \addspace \thefield { subtitle } }
        \tl_use:N \l_tmpa_tl
      }
  }
\ExplSyntaxOff
\DeclareFieldFormat[article,report,misc,inbook]{title}{%
  \ifthenelse{\boolean{japanese}}{%
    「#1%
    \iffieldundef{subtitle}{」}{}%
  }{%
    \bbx@meisei@quotedtitle{#1}%
  }%
}
\DeclareFieldFormat[article,report,misc,inbook]{subtitle}{%
  \ifthenelse{\boolean{japanese}}{%
    ------#1------」\setunit{}%
  }{}% 外国語の副題はタイトルの引用符内で出力済み
}
% 論文タイトルと雑誌名の区切り：外国語は引用符内にカンマがあるので空白のみ
\newcommand*{\bbx@meisei@titlejournalsep}{%
  \ifthenelse{\boolean{japanese}}{\newunit}{\setunit{\addspace}}%
}
% jpa.bbxのタイトル処理後に入るソース上の空白を除く
\xpatchbibdriver{article}
  {\iffieldundef{subtitle}{}{\printfield{subtitle}} \newunit\printfield{journaltitle}}
  {\iffieldundef{subtitle}{}{\printfield{subtitle}}\bbx@meisei@titlejournalsep\printfield{journaltitle}}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `article journal separator'}%
  }
\newcommand*{\bbx@articlevolumeissues}{%
  % 日本語：jpa.bbx のドライバのソース上の改行による空白を \unspace で除く
  \ifthenelse{\boolean{japanese}}{\setunit{\unspace}}{\setunit{\addcomma\addspace}}%
  \usebibmacro{volume+issues}%
}
\xpatchbibdriver{article}
  {\usebibmacro{volume+issues}}
  {\bbx@articlevolumeissues}
  {}{%
    \PackageWarningNoLine{biblatex}{meisei.bbx: failed to patch `article volume separator'}%
  }
%%% 巻号 %%%
% jpa.bbx は \mkbibemph{\printfield{volume}} としているため，直前の区切り
% （雑誌名の後のカンマ）まで斜体になる。フィールド書式で斜体にして回避し，
% 日本語文献の巻数は立体にする
\DeclareFieldFormat[article,report]{volume}{%
  \ifthenelse{\boolean{japanese}}{#1}{\mkbibitalic{#1}}%
}
\renewbibmacro*{volume+issues}{%
  \ifboolexpr{
    test {\iffieldundef{volume}}
    and
    not test {\iffieldundef{number}}
  }{%
    \printtext{No. }%
    \printfield{number}%
    \setunit*{\addcomma\addspace}%
  }{%
    \printfield{volume}%
    \iffieldundef{number}{}{%
      \setunit*{\addthinspace}%
      \printtext[parens]{\printfield{number}}%
    }%
    \setunit*{\addcomma\addspace}%
  }%
}
%%% 雑誌名 %%%
\DeclareFieldFormat[article,report,misc]{journaltitle}{%
  \ifthenelse{\boolean{japanese}}{%
    \ifdefined\inhibitglue\inhibitglue\fi%
    \ifentrytype{article}{\thinspace}{}%
    『#1』%
  }{%
    \mkbibitalic{#1}%
  }%
}%

%%% URLと取得日 %%%
\DeclareFieldFormat{url}{%
  \renewcommand*{\finentrypunct}{}%
  \\\url{#1}\nopunct%
}
% 日本語：（2026年11月1日 参照）
% 外国語：(accessed November 1, 2026)
\DeclareFieldFormat{urldate}{%
  \ifthenelse{\boolean{japanese}}{%
    \begingroup
    \ifdefined\ltjsetparameter\ltjsetparameter{autoxspacing=false}\fi
    （\thefield{urlyear}年%
    \iffieldundef{urlmonth}{}{\thefield{urlmonth}月}%
    \iffieldundef{urlday}{}{\thefield{urlday}日}\ 参照）%
    \endgroup
  }{%
    (accessed
    \iffieldundef{urlmonth}{}{\mkbibmonth{\thefield{urlmonth}}\addspace}%
    \iffieldundef{urlday}{}{\thefield{urlday}\addcomma\addspace}%
    \thefield{urlyear})%
  }%
}
% 表示（閲覧日がなくても URL は出す）
\renewbibmacro*{url+urldate}{%
  \iffieldundef{url}
  {}
  {\printfield{url}\setunit{\addspace}}\printurldate}

%%%%%% 報告書（report）・新聞/雑誌記事（misc）%%%%%%
%%% 著者のない報告書は機関名を著者として扱う（文献リスト・引用・並べ替え）%%%
\DeclareStyleSourcemap{
  \maps[datatype=bibtex]{
    \map{
      \pertype{report}
      \step[notfield=author, final]
      \step[fieldsource=institution, final]
      \step[fieldset=author, origfieldval]
      \step[fieldsource=author, match=\regexp{\A(.+)\Z}, replace=\regexp{\{$1\}}]
      \step[fieldset=meiseiinstauthor, fieldvalue={true}]
    }
    % year に月が含まれている場合（year = {March 2020}，{2020 Mar.}，
    % {2020年3月} など），年だけを year に残し，月は month に移す
    % （引用が「著者 (March 2020)」のようにならないようにする）。
    % month がすでにある場合は month をそのまま使う
    \map{
      \step[notfield=month, final]
      \step[fieldsource=year, match=\regexp{\A\s*([A-Za-z]+)\.?,?\s+(\d{4})\s*\Z}, final]
      \step[fieldset=year, fieldvalue={$2}]
      \step[fieldset=month, fieldvalue={$1}]
    }
    \map{
      \step[notfield=month, final]
      \step[fieldsource=year, match=\regexp{\A\s*([A-Za-z]+)\.?\s*[-/\x{2013}]+\s*[A-Za-z]+\.?,?\s+(\d{4})\s*\Z}, final]
      \step[fieldset=year, fieldvalue={$2}]
      \step[fieldset=month, fieldvalue={$1}]
    }
    \map{
      \step[notfield=month, final]
      \step[fieldsource=year, match=\regexp{\A\s*(\d{4}),?\s+([A-Za-z]+)\.?\s*\Z}, final]
      \step[fieldset=year, fieldvalue={$1}]
      \step[fieldset=month, fieldvalue={$2}]
    }
    \map{
      \step[notfield=month, final]
      \step[fieldsource=year, match=\regexp{\A\s*(\d{4})\s*年\s*(\d{1,2})\s*月?\s*\Z}, final]
      \step[fieldset=year, fieldvalue={$1}]
      \step[fieldset=month, fieldvalue={$2}]
    }
    \map{
      \step[fieldsource=year, match=\regexp{\A\s*[A-Za-z]+\.?,?\s+(\d{4})\s*\Z}, replace={$1}]
      \step[fieldsource=year, match=\regexp{\A\s*[A-Za-z]+\.?\s*[-/\x{2013}]+\s*[A-Za-z]+\.?,?\s+(\d{4})\s*\Z}, replace={$1}]
      \step[fieldsource=year, match=\regexp{\A\s*(\d{4}),?\s+[A-Za-z]+\.?\s*\Z}, replace={$1}]
      \step[fieldsource=year, match=\regexp{\A\s*(\d{4})\s*年\s*\d{1,2}\s*月?\s*\Z}, replace={$1}]
    }
    % 開始と終了が同じ年の期間（date = {1973-05/1973-06} など）は開始日だけにする
    % （「著者 (1973–1973)」とならないようにする）
    \map{
      \step[fieldsource=date, match=\regexp{\A\s*(\d{4})((?:-\d\d){0,2})\s*/\s*\1(?:-\d\d){0,2}\s*\Z}, replace={$1$2}]
    }
    % 月名（英語）を数字にする（March → 3）
    \map{
      \step[fieldsource=month, match=\regexp{\A\s*(?i:jan(?:uary)?)\.?\s*\Z}, replace={1}]
      \step[fieldsource=month, match=\regexp{\A\s*(?i:feb(?:ruary)?)\.?\s*\Z}, replace={2}]
      \step[fieldsource=month, match=\regexp{\A\s*(?i:mar(?:ch)?)\.?\s*\Z}, replace={3}]
      \step[fieldsource=month, match=\regexp{\A\s*(?i:apr(?:il)?)\.?\s*\Z}, replace={4}]
      \step[fieldsource=month, match=\regexp{\A\s*(?i:may)\.?\s*\Z}, replace={5}]
      \step[fieldsource=month, match=\regexp{\A\s*(?i:june?)\.?\s*\Z}, replace={6}]
      \step[fieldsource=month, match=\regexp{\A\s*(?i:july?)\.?\s*\Z}, replace={7}]
      \step[fieldsource=month, match=\regexp{\A\s*(?i:aug(?:ust)?)\.?\s*\Z}, replace={8}]
      \step[fieldsource=month, match=\regexp{\A\s*(?i:sep(?:t(?:ember)?)?)\.?\s*\Z}, replace={9}]
      \step[fieldsource=month, match=\regexp{\A\s*(?i:oct(?:ober)?)\.?\s*\Z}, replace={10}]
      \step[fieldsource=month, match=\regexp{\A\s*(?i:nov(?:ember)?)\.?\s*\Z}, replace={11}]
      \step[fieldsource=month, match=\regexp{\A\s*(?i:dec(?:ember)?)\.?\s*\Z}, replace={12}]
      \step[fieldsource=month, match=\regexp{\A\s*(\d{1,2})\s*月\s*\Z}, replace={$1}]
    }
  }
}

%%% 著者と発行機関が同じかどうかの判定（同じなら発行機関を省く：APA）%%%
% 著者が1名・名なし（団体名）で，その名前が機関名の1件目と一致すれば真
\ExplSyntaxOn
\str_new:N \g__meisei_authorstr_str
\str_new:N \g__meisei_inststr_str
\cs_new_protected:Npn \__meisei_normstr:Nn #1 #2
  {
    \str_set:Nn #1 {#2}
    \str_remove_all:Nn #1 { \{ }
    \str_remove_all:Nn #1 { \} }
    \str_remove_all:Nn #1 { ~ }
  }
\DeclareNameFormat{meisei-namestr}
  {
    \bool_lazy_and:nnT
      { \int_compare_p:n { \value{listtotal} = 1 } }
      { \tl_if_blank_p:o { \namepartgiven } }
      {
        \exp_args:NNo \__meisei_normstr:Nn \l_tmpa_str { \namepartfamily }
        \str_gset_eq:NN \g__meisei_authorstr_str \l_tmpa_str
      }
  }
\DeclareListFormat{meisei-liststr}
  {
    \int_compare:nT { \value{listcount} = 1 }
      {
        \__meisei_normstr:Nn \l_tmpa_str {#1}
        \str_gset_eq:NN \g__meisei_inststr_str \l_tmpa_str
      }
  }
\cs_new_protected:Npn \bbx@meisei@ifinstisauthor #1 #2
  {
    \str_gclear:N \g__meisei_authorstr_str
    \str_gclear:N \g__meisei_inststr_str
    \group_begin:
      \printnames[meisei-namestr]{author}
      \printlist[meisei-liststr]{institution}
    \group_end:
    \bool_lazy_and:nnTF
      { ! \str_if_empty_p:N \g__meisei_authorstr_str }
      { \str_if_eq_p:NN \g__meisei_authorstr_str \g__meisei_inststr_str }
      {#1} {#2}
  }
\ExplSyntaxOff
\newcommand*{\bbx@meisei@printinst}{%
  \iffieldundef{meiseiinstauthor}{%
    \bbx@meisei@ifinstisauthor{}{\printlist{institution}}%
  }{}%
}

%%% 報告書 %%%
% 日本語：著者 (年)「表題 —— 副題 ——」『誌名』巻(号) 機関名
%         著者 (年)「表題」種類 No. 番号 機関名（誌名がない場合）
% 外国語：Author (Year). “Title: Subtitle,” Journal, Vol (No), Institution Type No. Number.
\DeclareBibliographyDriver{report}{%
  \usebibmacro{begentry}%
  % 外国語：発行機関を省き，誌名・種類・番号もなければ引用符内をピリオドにする
  % （World Bank (2021). “World Development Report.” https://...）
  \ifthenelse{\boolean{japanese}}{}{%
    \ifboolexpr{
      test {\iffieldundef{journaltitle}}
      and test {\iffieldundef{type}}
      and test {\iffieldundef{number}}
    }{%
      \iffieldundef{meiseiinstauthor}{%
        \bbx@meisei@ifinstisauthor{\def\bbx@meisei@titlepunct{.}}{}%
      }{\def\bbx@meisei@titlepunct{.}}%
    }{}%
  }%
  \usebibmacro{author+year}%
  \setunit{\bbx@nameyearpunct{\addperiod\addspace}}%
  \printfield{title}%
  \iffieldundef{subtitle}{}{\printfield{subtitle}}%
  \ifthenelse{\boolean{japanese}}{%
    \setunit{}%
    \iffieldundef{journaltitle}{%
      % 誌名がなければ「種類 No. 番号」（ディスカッションペーパー No. 5）
      \setunit{\addspace}\printfield{type}%
      \iffieldundef{number}{}{%
        \setunit{\addspace}\printtext{No.\addnbspace\thefield{number}}}%
    }{%
      % 誌名があれば『誌名』巻(号)
      \printfield{journaltitle}%
      \setunit{}\printfield{volume}%
      \setunit{}\printfield[parens]{number}%
    }%
    \setunit{\addjspace}\bbx@meisei@printinst
  }{%
    \setunit{\addspace}%
    \iffieldundef{journaltitle}{}{%
      \printfield{journaltitle}%
      \setunit{\addcomma\addspace}\printfield{volume}%
      \setunit{\addthinspace}\printfield[parens]{number}%
      \setunit{\addcomma\addspace}%
    }%
    \bbx@meisei@printinst
    \iffieldundef{journaltitle}{%
      \setunit{\addspace}\printfield{type}%
      \iffieldundef{number}{}{%
        \setunit{\addspace}\printtext{No.\addnbspace\thefield{number}}}%
    }{}%
  }%
  \setunit{\addspace}\usebibmacro{url+urldate}%
  \usebibmacro{finentry}%
}

%%% 新聞・雑誌記事 %%%
% 日本語：著者 (年)「表題」『紙誌名』7月29日朝刊, 1
% 外国語：Author (Year). “Title,” Newspaper, March 5, Edition, A1.
\newcommand*{\bbx@meisei@jamonthday}{%
  \ifdefined\ltjsetparameter\ltjsetparameter{autoxspacing=false}\fi
  \thefield{month}月\iffieldundef{day}{}{\thefield{day}日}%
}
\DeclareBibliographyDriver{misc}{%
  \usebibmacro{begentry}%
  \usebibmacro{author+year}%
  \setunit{\bbx@nameyearpunct{\addperiod\addspace}}%
  \printfield{title}%
  \iffieldundef{subtitle}{}{\printfield{subtitle}}%
  \ifthenelse{\boolean{japanese}}{%
    \setunit{}\printfield{journaltitle}%
    \iffieldundef{month}{}{%
      \setunit{}\printtext{\bbx@meisei@jamonthday}}%
    \iffieldundef{month}{\setunit{\addspace}}{\setunit{}}%
    \printfield{howpublished}%
    % 月日・版がなければページは空白で続ける（『週刊エコノミスト』 20–23）
    \ifboolexpr{test {\iffieldundef{month}} and test {\iffieldundef{howpublished}}}
      {\setunit{\addspace}}{\setunit{\addcomma\addspace}}%
    \printfield{pages}%
  }{%
    \setunit{\addspace}\printfield{journaltitle}%
    \iffieldundef{month}{}{%
      \setunit{\addcomma\addspace}%
      \printtext{\mkbibmonth{\thefield{month}}%
        \iffieldundef{day}{}{\addnbspace\thefield{day}}}}%
    \setunit{\addcomma\addspace}\printfield{howpublished}%
    \setunit{\addcomma\addspace}\printfield{pages}%
  }%
  \setunit{\addspace}\usebibmacro{url+urldate}%
  \usebibmacro{finentry}%
}

%%% 文献リストの見出し：日本語の文書では「参考文献」 %%%
% LuaTeX-ja（\ltjsetparameter）または pLaTeX/upLaTeX（\kanjiskip）が
% 使われていれば日本語の文書とみなす
\AtEndPreamble{%
  \ifboolexpr{
    test {\ifdefmacro{\ltjsetparameter}}
    or
    test {\ifcsdef{kanjiskip}}
  }{%
    \DefineBibliographyStrings{english}{%
      references = {参考文献},
      bibliography = {参考文献},
    }%
  }{}%
}

\endinput
